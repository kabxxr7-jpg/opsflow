# Postgres connection used by the app at runtime (Supabase: use the "Transaction" pooler / pgbouncer URL in prod).
# Local dev: a plain local Postgres URL works fine for both DATABASE_URL and DIRECT_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/opsflow_dev"

# Direct (non-pooled) connection, required by Prisma Migrate. In Supabase this is the "Session"/direct connection
# string (port 5432), distinct from the pooled URL above (port 6543). Locally, same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/opsflow_dev"

# Google Gemini API key (free tier, no card required) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Random 32+ byte secret used to sign the session cookie (see lib/auth.ts). Generate with:
# openssl rand -hex 32
# Login itself is real email+password auth against the User table (scrypt-hashed, lib/password.ts)
# — there's no shared app-wide password. prisma/seed.ts creates the demo accounts; see README.
SESSION_SECRET=""

# Shared secret the n8n workflow (integrations/n8n/) signs its callback requests with, verified
# by app/api/integrations/n8n-callback/route.ts. Generate with: openssl rand -hex 32
N8N_CALLBACK_SECRET=""

# Required in production: the two Vercel Cron jobs (retry-webhooks, simulate-day) refuse every request
# that doesn't carry it — if it's unset there, they return 401 rather than running open. Vercel sends it
# automatically as `Authorization: Bearer <CRON_SECRET>`. Unset locally is fine (the check is skipped
# outside production). Generate with: openssl rand -hex 32
CRON_SECRET=""

# Read only by prisma/seed.ts, to build the URL of the built-in webhook receiver it configures
# (this app's own /api/integrations/test-echo). Defaults to http://localhost:3002 if unset.
# The running app and the cron jobs don't use it, so production doesn't need it set.
APP_BASE_URL=""
