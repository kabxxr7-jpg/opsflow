# Postgres connection used by the app at runtime (Supabase: use the "Transaction" pooler / pgbouncer URL in prod).
# Local dev: a plain local Postgres URL works fine for both DATABASE_URL and DIRECT_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/opsflow_dev"

# Direct (non-pooled) connection, required by Prisma Migrate. In Supabase this is the "Session"/direct connection
# string (port 5432), distinct from the pooled URL above (port 6543). Locally, same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/opsflow_dev"

# Google Gemini API key (free tier, no card required) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Single-user login password for this app (see lib/auth.ts). Pick anything non-trivial.
APP_PASSWORD=""

# Optional: shown as a visible hint on the login screen (client-side, not secret) for public
# portfolio demos. Set this to the same value as APP_PASSWORD so visitors can actually get in
# without asking you for a password. Leave unset for a private deployment.
NEXT_PUBLIC_DEMO_HINT=""

# Random 32+ byte secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Shared secret the n8n workflow (integrations/n8n/) signs its callback requests with, verified
# by app/api/integrations/n8n-callback/route.ts. Generate with: openssl rand -hex 32
N8N_CALLBACK_SECRET=""

# Optional: verifies the two Vercel Cron jobs (retry-webhooks, simulate-day) are actually Vercel
# invoking them, not an open endpoint anyone can hit. Vercel sends it automatically as
# `Authorization: Bearer <CRON_SECRET>`. Unset locally is fine — the check is skipped.
CRON_SECRET=""

# Used by prisma/seed.ts and the simulate-day cron job to build the webhook target URL and to
# know the app's own public origin. Defaults to http://localhost:3002 if unset.
APP_BASE_URL=""
