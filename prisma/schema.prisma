// Prisma schema for Opsflow — a field-service ops automation + AI reporting platform.
// Data is seeded/simulated (mock connector), modeled on real-world field-service platforms.
// Not a claim of integration with any specific named vendor.
//
// Multi-tenant: every tenant-scoped model carries a non-nullable, indexed organizationId.
// Direct Prisma calls on these models are never made with the raw client in application code —
// see lib/db.ts's getScopedDb()/getOrgDb(), which inject organizationId automatically. The raw
// client is only ever touched by the scoping layer itself and by Organization/User management.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users              User[]
  customers          Customer[]
  technicians        Technician[]
  jobs               Job[]
  tickets            Ticket[]
  automationRules    AutomationRule[]
  automationRuns     AutomationRun[]
  webhookConfigs     WebhookConfig[]
  webhookDeliveries  WebhookDelivery[]
  dailyBriefings     DailyBriefing[]
}

enum UserRole {
  OWNER
  DISPATCHER
  TECHNICIAN
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole
  createdAt      DateTime     @default(now())

  assignedJobs Job[] @relation("JobAssignee")

  @@index([organizationId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime     @default(now())
  jobs           Job[]

  @@index([organizationId])
}

model Technician {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  skills         String[]     @default([])
  createdAt      DateTime     @default(now())
  jobs           Job[]

  @@index([organizationId])
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Job {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  technicianId   String?
  technician     Technician?  @relation(fields: [technicianId], references: [id])
  // The User (role TECHNICIAN) who may view/update this job's status. Distinct from
  // `technician` (the simulated field-service crew member record shown in the UI) — this is
  // the auth-layer scoping field, kept separate on purpose so the demo-data "Technician" roster
  // doesn't have to line up 1:1 with real login accounts.
  assignedToId   String?
  assignedTo     User?        @relation("JobAssignee", fields: [assignedToId], references: [id])
  jobType        String
  status         JobStatus    @default(SCHEDULED)
  scheduledAt    DateTime?
  completedAt    DateTime?
  revenue        Decimal?     @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tickets           Ticket[]
  automationRuns    AutomationRun[]
  webhookDeliveries WebhookDelivery[]

  @@index([organizationId, status])
  @@index([customerId])
  @@index([assignedToId])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String?
  job            Job?         @relation(fields: [jobId], references: [id])
  rawText        String
  source         String
  createdAt      DateTime     @default(now())

  // AI-extracted fields, Zod-validated before being persisted here
  classification String?
  priority       TicketPriority?
  summary        String?
  confidence     Float?
  sourceSnippet  String?

  // Set only for source: "ocr_upload" tickets. Distinct from `confidence` (the AI
  // classification's confidence) — a low OCR score means the extracted text itself may be
  // garbled, a different failure mode than the AI being unsure how to classify clear text.
  ocrConfidence Float?

  @@index([organizationId, classification])
  @@index([jobId])
}

model AutomationRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean      @default(true)
  trigger        Json
  filters        Json?
  actions        Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  runs AutomationRun[]

  @@index([organizationId])
}

enum RunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model AutomationRun {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleId         String
  rule           AutomationRule @relation(fields: [ruleId], references: [id])
  jobId          String?
  job            Job?           @relation(fields: [jobId], references: [id])
  status         RunStatus
  log            String?
  createdAt      DateTime       @default(now())

  @@index([organizationId, ruleId])
  @@index([jobId])
}

model WebhookConfig {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetUrl      String
  secret         String
  isActive       Boolean      @default(true)
  // Job statuses that fire this webhook, e.g. [COMPLETED] fires only when a job completes.
  triggerOn      JobStatus[]  @default([])
  createdAt      DateTime     @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookConfigId String
  webhookConfig   WebhookConfig @relation(fields: [webhookConfigId], references: [id])
  jobId           String?
  job             Job?          @relation(fields: [jobId], references: [id])
  eventType       String
  payload         Json
  attemptNumber   Int
  statusCode      Int?
  responseBody    String?
  success         Boolean
  errorMessage    String?
  durationMs      Int?
  nextRetryAt     DateTime?
  createdAt       DateTime      @default(now())

  @@index([organizationId, success, nextRetryAt])
  @@index([jobId])
}

model DailyBriefing {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  summary        String
  highlights     Json
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
